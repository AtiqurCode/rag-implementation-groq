# https://console.groq.com/keys
GROQ_API_KEY=

# Public Groq chat model. Llama 3.3 was removed from Groq on 2026-08-16.
GROQ_CHAT_MODEL=openai/gpt-oss-120b
# low is the right default for grounded extraction. Use medium or high for harder questions.
GROQ_REASONING_EFFORT=low
GROQ_TEMPERATURE=0.2
GROQ_MAX_COMPLETION_TOKENS=2048
INCLUDE_REASONING=false

# This Groq account serves chat models only. Embeddings run locally.
# Set EMBED_PROVIDER=groq if your key can call nomic-embed-text-v1_5.
EMBED_PROVIDER=local
LOCAL_EMBED_MODEL=BAAI/bge-small-en-v1.5
GROQ_EMBED_MODEL=nomic-embed-text-v1_5
EMBED_BATCH_SIZE=32

CHROMA_PATH=storage/chroma
COLLECTION_NAME=pdf_rag

# Characters, not tokens. Overlap must be smaller than size.
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5
# Cosine similarity. Lower this if good passages are being dropped.
MIN_RELEVANCE=0.3
